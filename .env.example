# ============ Trilium 连接 ============
# Trilium 服务地址（不要带 /etapi 后缀）
TRILIUM_URL=http://localhost:8080

# ETAPI token：Trilium -> Options -> ETAPI -> Create new token
ETAPI_TOKEN=

# 分享根笔记的 noteId（右侧三点 -> Show note info / 或从 URL /share/xxxx 复制）
# 该笔记及其子笔记会被预取，用于渲染首页列表与详情页
ROOT_NOTE_ID=

# ============ 本地服务 ============
PORT=4321
# 主题文件目录（默认 ../TimelyBlogTheme，即与 TimelyBlogTheme 仓库同级）
THEME_DIR=../TimelyBlogTheme
# 主题 EJS 文件名
EJS_FILE=TimelyBlogTheme.ejs
# 主题 CSS / JS 文件名（本地文件名，映射用）
CSS_FILE=TimelyBlogTheme.css
JS_FILE=TimelyBlogTheme.js

# ============ 开发体验 ============
# 主题资源渲染模式（对应主题的三阶段流程）：
#   local  = 阶段① 开发 —— api/notes/<id>/download 与 CDN 地址都重写成本地文件，存盘即见
#   as-is  = 阶段② 预览 / ③ 上线 —— 不重写，页面保持 EJS 原样（②走 Trilium 托管、③走 CDN）
ASSET_MODE=local
# 主题文件变化时自动刷新浏览器
LIVE_RELOAD=1
# 元数据缓存时间（毫秒），0 = 每次都重新拉取
CACHE_TTL=30000
# 预取深度（对齐模板里的 maxDepth=5）
PREFETCH_DEPTH=6
# 预取笔记数量上限，防止大库拉爆
MAX_NOTES=2000
# 1 = 使用内置假数据（无需 Trilium 也能启动调试前端）
ETAPI_MOCK=0

# ============ 主题回推 Trilium（可选，npm run push） ============
# 对应 Trilium 里存放 EJS / CSS / JS 的 code 笔记 noteId
PUSH_NOTE_EJS=
PUSH_NOTE_CSS=
PUSH_NOTE_JS=
