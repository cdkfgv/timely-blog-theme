# 依赖（根目录统一安装，theme/ 与 dev/ 共用同一份）
node_modules/

# 发布产物 —— npm run build 生成，完全可从 theme/ 复现，不进版本库
dist/

# 环境变量 —— dev/.env 含 ETAPI token，绝不能提交
.env
.env.local

# 本地工作数据（记忆 / 计划等，不属于项目产物）
.workbuddy/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 日志与缓存
*.log
.cache/

# 无头 Chrome 临时文件（本机已停用截图，规则保留）
.tmp-shot/
.tmp-detail.html
.tmp-debug/
