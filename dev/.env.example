# ============ Trilium 连接 ============
# Trilium 服务地址（不要带 /etapi 后缀）
TRILIUM_URL=http://localhost:8080

# ETAPI token：Trilium -> Options -> ETAPI -> Create new token
ETAPI_TOKEN=

# 分享根笔记的 noteId（右侧三点 -> Show note info / 或从 URL /share/xxxx 复制）
# 该笔记及其子笔记会被预取，用于渲染首页列表与详情页
ROOT_NOTE_ID=

# ============ 本地服务 ============
PORT=4321
# 主题文件目录（默认 ../theme，即仓库内的 theme/ 子目录）
THEME_DIR=../theme
# 主题 EJS 文件名
EJS_FILE=TimelyBlogTheme.ejs
# 主题 CSS / JS 文件名（本地文件名，映射用）
CSS_FILE=TimelyBlogTheme.css
JS_FILE=TimelyBlogTheme.js

# ============ 开发体验 ============
# 主题资源渲染模式（EJS 里只有 CDN 一种写法）：
#   local  = 默认，开发用 —— 把 CDN 地址重写成本地文件，改 CSS/JS 存盘即见
#   as-is  = 验证线上形态 —— 不重写，页面保持 CDN 原文（会真的去外网拉）
ASSET_MODE=local
# 主题文件变化时自动刷新浏览器
LIVE_RELOAD=1
# 元数据缓存时间（毫秒），0 = 每次都重新拉取
CACHE_TTL=30000
# 预取深度（对齐模板里的 maxDepth=5）
PREFETCH_DEPTH=6
# 预取笔记数量上限，防止大库拉爆
MAX_NOTES=2000
# 1 = 使用内置假数据（无需 Trilium 也能启动调试前端）
ETAPI_MOCK=0

# ============ 主题回推 Trilium（npm run push） ============
# EJS = 分享根笔记的 ~shareTemplate 关系指向的 Code 笔记（**必填**，否则推不了模板）
# CSS/JS = 旧的 ~shareCss / ~shareJs 笔记（已停用；填了就顺手推一份最新副本当备份，留空则跳过）
PUSH_NOTE_EJS=
PUSH_NOTE_CSS=
PUSH_NOTE_JS=
