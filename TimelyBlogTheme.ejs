        <div id="post-content" class="prose-content min-h-[17dvh]" ref="contentEl" v-html="content"></div>
        <nav v-if="!isFixed" class="grid grid-cols-2 gap-4 mt-10 pt-6 border-t border-[#f5f5f4] dark:border-zinc-800">
          <a v-if="detail?.prevPost" :href="'./' + detail.prevPost.id" class="group block p-4 bg-white dark:bg-zinc-900/40 border border-[#f5f5f4] dark:border-zinc-800 rounded-xl">
            <div class="text-xs text-stone-400 dark:text-zinc-500 mb-2"><i class="fa-solid fa-arrow-left"></i> 上一篇</div>
            <div class="text-sm font-medium text-stone-600 dark:text-zinc-300 group-hover:text-stone-800 dark:group-hover:text-zinc-100 line-clamp-2">{{ detail.prevPost.title }}</div>
          </a>
          <div v-else class="p-4 rounded-xl border border-dashed border-[#f5f5f4] dark:border-zinc-800 flex items-center justify-center text-sm text-stone-400 dark:text-zinc-600">已是最新一篇</div>
          <a v-if="detail?.nextPost" :href="'./' + detail.nextPost.id" class="group block p-4 bg-white dark:bg-zinc-900/40 border border-[#f5f5f4] dark:border-zinc-800 rounded-xl text-right">
            <div class="text-xs text-stone-400 dark:text-zinc-500 mb-2">下一篇 <i class="fa-solid fa-arrow-right"></i></div>
            <div class="text-sm font-medium text-stone-600 dark:text-zinc-300 group-hover:text-stone-800 dark:group-hover:text-zinc-100 line-clamp-2">{{ detail.nextPost.title }}</div>
          </a>
          <div v-else class="p-4 rounded-xl border border-dashed border-[#f5f5f4] dark:border-zinc-800 flex items-center justify-center text-sm text-stone-400 dark:text-zinc-600">已是最后一篇</div>
        </nav>
      </article>
    </div>
  </template>

  <template id="tpl-search-modal">
    <div v-if="searchOpen" class="fixed inset-0 z-[100]" style="display:flex">
      <div class="absolute inset-0 bg-black/40 dark:bg-black/60 backdrop-blur-sm" @click="close"></div>
      <div class="absolute top-[20%] left-1/2 -translate-x-1/2 w-full max-w-lg px-4 z-10">
        <div class="bg-white dark:bg-zinc-900 border border-[#f5f5f4] dark:border-zinc-800 rounded-xl overflow-hidden shadow-2xl">
          <div class="flex items-center gap-3 px-4 py-3 border-b border-[#f5f5f4] dark:border-zinc-800">
            <i class="fa-solid fa-magnifying-glass text-stone-400 dark:text-zinc-500"></i>
            <input ref="inputEl" v-model="q" @keydown="onKey" type="text" placeholder="搜索文章..." autofocus class="flex-1 bg-transparent text-stone-800 dark:text-zinc-100 outline-none text-base">
            <button @click="close" class="text-stone-400 dark:text-zinc-500"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="max-h-80 overflow-y-auto py-2">
            <div v-if="q && !results.length" class="px-4 py-8 text-center text-stone-400 text-sm">
              <i class="fa-solid fa-magnifying-glass text-xl mb-2 block opacity-50"></i>没有找到相关文章
            </div>
            <template v-else>
              <a v-for="(p, i) in results" :key="p.id" :href="'./' + p.id" @click="close"
                 :class="['block px-4 py-3 transition-colors', selected === i ? 'bg-stone-100 dark:bg-zinc-800' : 'hover:bg-stone-100 dark:hover:bg-zinc-800']">
                <div class="font-medium text-stone-800 dark:text-zinc-100">{{ p.title }}</div>
                <div v-if="p.summary" class="text-xs text-stone-400 dark:text-zinc-500 mt-1 line-clamp-2">{{ p.summary.substring(0, 80) }}</div>
                <div class="text-xs text-stone-400 dark:text-zinc-500 mt-1">{{ p.date }}{{ p.category ? ' · ' + p.category : '' }}</div>
              </a>
            </template>
          </div>
        </div>
      </div>
    </div>
  </template>

  <template id="tpl-back-to-top">
    <button @click="scrollTop" :class="['fixed bottom-24 md:bottom-8 right-6 z-50 w-10 h-10 bg-stone-200 dark:bg-zinc-800 text-stone-500 dark:text-zinc-400 rounded-full shadow-lg transition-all cursor-pointer', visible ? 'opacity-100' : 'opacity-0 pointer-events-none']">
      <i class="fa-solid fa-arrow-up"></i>
    </button>
  </template>

  <template id="tpl-lightbox">
    <div v-if="lightboxOpen" class="fixed inset-0 z-[200] bg-black/80 items-center justify-center cursor-zoom-out" style="display:flex" @click="close">
      <img :src="lightboxSrc" class="max-w-[90vw] max-h-[90vh] rounded-lg object-contain" alt="" @click.stop>
    </div>
  </template>

  <template id="tpl-app-root"><div class="flex flex-col min-h-screen"><div id="reading-progress" class="fixed top-0 left-0 h-0.5 bg-gradient-to-r from-amber-600 to-amber-400 dark:from-amber-500 dark:to-yellow-400 z-[9999] transition-all" :style="{ width: progress + '%' }"></div><app-header @toggle-search="G.searchOpen.value = true"></app-header><div class="flex-1 flex flex-col max-w-[100rem] mx-auto w-full px-5 sm:px-8 xl:px-10 py-10 pb-28 md:pb-14"><div class="flex-1 grid lg:grid-cols-[1fr_270px] lg:items-start gap-10 xl:gap-12"><main id="main-scroll" class="min-w-0" ref="mainEl"></main><app-sidebar></app-sidebar></div></div><div class="mt-auto"><app-footer class="py-4"></app-footer></div><search-modal></search-modal><back-to-top></back-to-top><lightbox></lightbox></div></template>

<script src="https://cdn.jsdmirror.com/gh/cdkfgv/timely-theme@main/Timely-Theme/timely-theme.js"></script>
</body>
</html>
